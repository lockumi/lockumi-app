# App ID público de Cavos (Dashboard → App → Overview). Sin esta variable la app usa el acceso simulado.
VITE_CAVOS_APP_ID=

# ── Prueba e2e en Stellar testnet (rama testnet-e2e) ──
# Cliente (públicas, van al bundle):
VITE_SUPABASE_URL=https://sddgjnuvxzkrhhuczuly.supabase.co
VITE_SUPABASE_ANON_KEY=            # clave publishable/anon del proyecto (Settings → API)
VITE_TRUSTLESS=                    # 1 = escrow real de Trustless Work por /api/tw
VITE_VENTANA_SEGUNDOS=             # plazo de reclamos para la prueba (mín. 60; por defecto 7 días)
# Servidor (Vercel, SOLO Preview; nunca con prefijo VITE_):
TRUSTLESS_WORK_API_KEY=            # ya cargada en Vercel (Preview, sensitive)
LOCKUMI_TW_PLATAFORMA_SECRET=      # cuenta de plataforma GCTLNUBV…TJ4G (platformAddress, serviceProvider, releaseSigner, disputeResolver)
LOCKUMI_TW_MEDIADOR_PUBLICA=       # opcional: otra cuenta como disputeResolver (por defecto, la plataforma)
SUPABASE_URL=https://sddgjnuvxzkrhhuczuly.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
